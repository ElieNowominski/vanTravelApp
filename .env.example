# Supabase : URL du projet et clé publiable (Settings > API Keys). La clé publiable est faite pour le
# navigateur, la protection vient des règles par ligne (supabase/schema.sql). Jamais la clé secrète ici.
# Sans ces deux variables, l'app tourne en « local seulement » : pas de compte, pas de synchro.
VITE_SUPABASE_URL=https://<ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Préfixe d'URL du site. GitHub Pages projet : /vanTravelApp/ (le workflow le règle tout seul).
BASE_PATH=/
